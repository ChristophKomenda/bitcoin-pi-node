[Unit]
Description=Bitcoin Pi Node - guarded Docker Compose service
Requires=docker.service
After=docker.service
RequiresMountsFor=@STORAGE_DIR@
BindsTo=@MOUNT_UNIT@
After=@MOUNT_UNIT@

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/bitcoin-pi-node.env
WorkingDirectory=@REPO_DIR@
ExecStartPre=/usr/local/libexec/bitcoin-pi-node/check-storage
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=180
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
